# ============================================================
# Intelligent Knowledge Agent Platform - backend configuration
# Copy to `.env` and adjust. Everything works offline if unset.
# ============================================================

# --- LLM (智谱 GLM，Anthropic 兼容端点) ---
# 智谱 GLM 通过 Anthropic 兼容端点调用，使用 ANTHROPIC_AUTH_TOKEN 作为
# Bearer 令牌（Anthropic SDK 以 Authorization: Bearer <token> 发送）。
# 在 https://open.bigmodel.cn 申请 API Key。留空则以离线 mock 模式运行。
MODEL_NAME=glm-4.5-air
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# Anthropic messages API 要求的最大生成 token 数。
MAX_TOKENS=1024

# --- Embedding: openai | bge | hash (hash = offline fallback) ---
# 向量 embedding 走智谱 OpenAI 兼容端点（与上方同一个令牌）。
# 智谱示例: EMBEDDING_BACKEND=openai  OPENAI_EMBEDDING_MODEL=embedding-3  EMBEDDING_DIM=2048
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=2048
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- Reranker: cross-encoder | zhipu | lexical (lexical = offline fallback) ---
# zhipu = 智谱在线 rerank（标准 HTTP Bearer，与上方同一个 ANTHROPIC_AUTH_TOKEN），模型编码为 rerank。
# 未配置令牌时 zhipu 会自动回退到离线 lexical。
RERANKER_BACKEND=lexical
RERANKER_MODEL=BAAI/bge-reranker-large
# 智谱示例: RERANKER_BACKEND=zhipu  RERANKER_MODEL=rerank

# --- Vector store: chroma | memory ---
VECTOR_BACKEND=chroma
COLLECTION_NAME=knowledge_base
# Chroma 持久化目录，留空使用内置默认 backend/data/chroma。
# CHROMA_DIR=data/chroma

# --- RAG parameters ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=20
RERANK_TOP_N=5
CONFIDENCE_THRESHOLD=0.30

# --- Tools: tavily | mock ---
# 仅实现了 Tavily 搜索；无 key 或调用失败时回退确定性 mock 结果。
WEB_SEARCH_PROVIDER=mock
WEB_SEARCH_API_KEY=

# --- Database ---
# 默认 SQLite（零配置），留空使用内置默认 sqlite:///backend/data/app.db。
# 可替换为 PostgreSQL 等 SQLAlchemy 连接串。
# DATABASE_URL=sqlite:///data/app.db

# --- Redis（可选，分布式会话记忆）---
# 空 = 使用进程内记忆；配置且 Redis 可达时自动切换为 Redis 会话记忆。
REDIS_URL=

# --- Observability（可选，OpenTelemetry 追踪）---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rag-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Misc ---
# 上传文件保存目录，留空使用内置默认 backend/data/uploads。
# UPLOAD_DIR=data/uploads
# 允许的前端源（逗号分隔）；生产环境建议设为具体域名以启用 credentials。
CORS_ORIGINS=*
