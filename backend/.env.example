# ============================================================
# Intelligent Knowledge Agent Platform - backend configuration
# Copy to `.env` and adjust. Everything works offline if unset.
# ============================================================

# --- LLM (OpenAI compatible: 智谱 GLM / OpenAI / Azure / DeepSeek / Qwen) ---
# 智谱 GLM 使用 AUTH_TOKEN 作为 Bearer 令牌（Authorization: Bearer <token>）。
# 留空 AUTH_TOKEN 则以离线 mock 模式运行。
# 智谱示例: OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4  MODEL_NAME=glm-4.5-air
MODEL_NAME=glm-4.5-air
AUTH_TOKEN=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- Embedding: openai | bge | hash (hash = offline fallback) ---
# 智谱示例: EMBEDDING_BACKEND=openai  OPENAI_EMBEDDING_MODEL=embedding-3  EMBEDDING_DIM=2048
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=2048

# --- Reranker: cross-encoder | lexical (lexical = offline fallback) ---
RERANKER_BACKEND=lexical
RERANKER_MODEL=BAAI/bge-reranker-large

# --- Vector store: chroma | memory ---
VECTOR_BACKEND=chroma
COLLECTION_NAME=knowledge_base

# --- RAG parameters ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=20
RERANK_TOP_N=5
CONFIDENCE_THRESHOLD=0.30

# --- Tools ---
WEB_SEARCH_PROVIDER=mock
WEB_SEARCH_API_KEY=

# --- CORS ---
CORS_ORIGINS=*
